{
  "name": "creditloop",
  "version": "1.0.0",
  "private": true,
  "description": "CreditLoop \u2014 Turn refunds into repeat purchases. A Shopify public app built on native Shopify Store Credit.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
