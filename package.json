    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed:demo": "node scripts/seed-demo.js",
    "test": "node --import ./tests/alias-hook.mjs --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "bootstrap": "^5.3.3",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.1.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1"
  },
  "type": "module",
  "workspaces": [
    "extensions-pending-approval/*"
  ]
